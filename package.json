{
  "name": "@ameer-jamal/agent-dispatcher",
  "version": "0.1.0-alpha.2",
  "description": "Local subscription-aware MCP task dispatch with Codex allowance protection",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "agent-dispatcher": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "package:check": "node scripts/package-check.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "muse-client": "0.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.14.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ameer-Jamal/agent-dispatcher.git"
  },
  "homepage": "https://github.com/Ameer-Jamal/agent-dispatcher#readme",
  "bugs": {
    "url": "https://github.com/Ameer-Jamal/agent-dispatcher/issues"
  },
  "keywords": [
    "mcp",
    "agents",
    "dispatcher",
    "codex",
    "claude",
    "antigravity",
    "opencode",
    "cursor"
  ]
}
